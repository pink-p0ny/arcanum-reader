{
  "expo": {
    "name": "Arcanum",
    "slug": "arcanum",
    "owner": "pink-pony-software",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "arcanum",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.snobunny.arcanum",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUbiquitousContainers": {
          "iCloud.net.snobunny.arcanum": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Arcanum",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        },
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "EPUB book",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["org.idpf.epub-container"]
          },
          {
            "CFBundleTypeName": "PDF document",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["com.adobe.pdf"]
          },
          {
            "CFBundleTypeName": "Plain text",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.plain-text"]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "usesIcloudStorage": true,
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": ["iCloud.net.snobunny.arcanum"],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.net.snobunny.arcanum"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#130f26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.snobunny.arcanum",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#130f26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "expo-audio",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "54ce969a-5046-4a16-840b-b0286529938a"
      },
      "revenueCatIosKey": "appl_JvjcaPsOnBdPDgLIzyXVHBECjDp"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/54ce969a-5046-4a16-840b-b0286529938a"
    }
  }
}
